{
	"name": "textmode.synth.js",
	"version": "1.7.2",
	"description": "Synth engine for textmode.js",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.0.0",
			"onFail": "error"
		}
	},
	"main": "./dist/textmode.synth.umd.js",
	"module": "./dist/textmode.synth.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.synth.esm.js",
			"require": "./dist/textmode.synth.umd.js"
		}
	},
	"sideEffects": [
		"./src/bootstrap.ts",
		"./dist/textmode.synth.esm.js",
		"./dist/textmode.synth.umd.js"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "textmode-build dev --port 5176 --host",
		"build:bundle": "textmode-build build",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run format:check && npm run lint && npm run lint:markdown && npm run typecheck && npm run docs:check && npm run test && npm run build && npm run types:verify",
		"docs:links:add": "textmode-docs links add",
		"docs:api:check": "textmode-docs api-check",
		"docs:check": "textmode-docs check",
		"docs:dev": "textmode-docs watch",
		"docs:build": "textmode-docs build",
		"preview": "textmode-build preview",
		"test": "textmode-build test",
		"test:watch": "textmode-build test:watch",
		"test:unit": "textmode-build test --project unit",
		"test:integration": "textmode-build test --project integration",
		"format": "textmode-lint format",
		"format:check": "textmode-lint format:check",
		"typecheck": "textmode-types check",
		"types:verify": "textmode-types verify",
		"lint:markdown": "textmode-lint lint:markdown",
		"lint:markdown:fix": "textmode-lint lint:markdown --fix",
		"lint": "textmode-lint lint src",
		"prepare": "textmode-release hooks",
		"prepack": "npm run build && npm run types:verify",
		"release": "textmode-release release"
	},
	"peerDependencies": {
		"textmode.js": ">=0.18.0 <0.20.0"
	},
	"devDependencies": {
		"@textmode/build": "^0.1.0",
		"@textmode/docs": "^0.3.0",
		"@textmode/lint": "^0.1.0",
		"@textmode/release": "^0.1.0",
		"@textmode/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"textmode.js": "file:../textmode.js-dev",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"ascii",
		"petscii",
		"textmode",
		"canvas",
		"webgl",
		"creative-coding",
		"art",
		"design",
		"graphics",
		"ascii-art",
		"live-coding",
		"synthesis"
	],
	"author": "humanbydefinition",
	"license": "AGPL-3.0",
	"homepage": "https://code.textmode.art",
	"prettier": "@textmode/lint/prettier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.synth.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.synth.js/issues"
	}
}
