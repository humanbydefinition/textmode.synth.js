{
	"name": "textmode.synth.js",
	"version": "1.7.1",
	"description": "Synth engine for textmode.js",
	"type": "module",
	"main": "./dist/textmode.synth.umd.js",
	"module": "./dist/textmode.synth.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.synth.esm.js",
			"require": "./dist/textmode.synth.umd.js"
		}
	},
	"sideEffects": [
		"./src/bootstrap.ts",
		"./dist/textmode.synth.esm.js",
		"./dist/textmode.synth.umd.js"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --port 5176 --host",
		"build:bundle": "vite build",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run check:format && npm run lint && npm run lint:md && npm run check:types && npm run check:docs && npm run test && npm run build && npm run check:package-types",
		"docs:links:add": "textmode-docs links add",
		"check:api-docs": "textmode-docs api-check",
		"check:docs": "textmode-docs check",
		"dev:docs": "textmode-docs watch",
		"build:docs": "textmode-docs build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"format": "prettier --write . --ignore-unknown",
		"check:format": "prettier --check . --ignore-unknown",
		"check:types": "textmode-types check",
		"check:package-types": "textmode-types verify",
		"lint:md": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2 --fix",
		"lint": "eslint src",
		"prepare": "install-git-hooks"
	},
	"peerDependencies": {
		"textmode.js": ">=0.16.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/docs": "^0.2.2",
		"@textmode/eslint-config": "^0.2.0",
		"@textmode/markdownlint-config": "^0.1.1",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/release-config": "^0.1.2",
		"@textmode/tooling-scripts": "^0.4.0",
		"@textmode/tsconfig": "^0.2.0",
		"@textmode/vite-config": "^0.1.0",
		"@textmode/vitest-config": "^0.2.1",
		"@types/node": "^26.1.1",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.6.0",
		"jsdom": "^30.0.0",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.23.0",
		"prettier": "^3.9.4",
		"semantic-release": "^25.0.5",
		"terser": "^5.46.1",
		"textmode.js": "^0.17.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"ascii",
		"petscii",
		"textmode",
		"canvas",
		"webgl",
		"creative-coding",
		"art",
		"design",
		"graphics",
		"ascii-art",
		"live-coding",
		"synthesis"
	],
	"author": "humanbydefinition",
	"license": "AGPL-3.0",
	"homepage": "https://code.textmode.art",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"release": {
		"extends": "@textmode/release-config"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.synth.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.synth.js/issues"
	},
	"markdownlint-cli2": {
		"globs": [
			"**/*.md"
		],
		"ignores": [
			"api/**",
			"node_modules/**",
			"dist/**",
			"examples/**/*.md",
			"**/CHANGELOG.md",
			".agents/**"
		],
		"fix": false,
		"outputFormatters": [
			[
				"markdownlint-cli2-formatter-default"
			]
		],
		"config": {
			"extends": "@textmode/markdownlint-config"
		}
	}
}
